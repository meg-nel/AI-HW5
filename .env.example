# Copy this file to .env (same folder) and paste your key after the = sign.
# .env is gitignored, so your key never goes to GitHub.
OPENAI_API_KEY=your-portkey-api-key

# The key is a Portkey gateway key (https://app.portkey.ai/api-keys), so requests go through Portkey.
OPENAI_BASE_URL=https://api.portkey.ai/v1
